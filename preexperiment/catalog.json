{
  "modules": {
    "Queue1_UInt8": {
      "category": "单项流水队列",
      "reason": "44 行，无子模块；可检查满空、背压、同时出入队和数据采样。",
      "dependencies": [],
      "clocked": true,
      "notes": "满时允许随出队同时入队；空时没有组合数据直通。"
    },
    "Queue6_UInt2": {
      "category": "六项直通队列",
      "reason": "67 行，仅依赖一个 6×2 RAM；增加指针回绕和空队列直通场景。",
      "dependencies": [
        "ram_6x2.sv"
      ],
      "clocked": true,
      "notes": "空时 valid/data 可组合直通；不能直接照搬单项队列的所有时序性质。"
    },
    "XsRRArbiter": {
      "category": "双输入轮询仲裁器",
      "reason": "64 行，无子模块；适合检查接受互斥、事务字段转发和授权状态更新。",
      "dependencies": [],
      "clocked": true,
      "notes": "空闲时两个 ready 可能同时为高；互斥对象是实际接受的传输。"
    },
    "ExclusiveMonitorEntry": {
      "category": "独占监视条目",
      "reason": "75 行，无子模块；适合检查实体匹配、标签匹配和停用状态转换。",
      "dependencies": [],
      "clocked": true,
      "notes": "标签寄存器没有复位值，只在对应请求到达后检查其采样关系。"
    },
    "PriorityEncoderOneHotLow8": {
      "category": "低位优先独热编码器",
      "reason": "18 行，无状态、无依赖；用于最先跑通工具和评价流程。",
      "dependencies": [],
      "clocked": false,
      "notes": "纯组合模块，不为它引入虚构的 DUT 时钟或复位。"
    }
  },
